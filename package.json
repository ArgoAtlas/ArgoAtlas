{
  "name": "argoatlas",
  "version": "0.1.0",
  "description": "Real-time global maritime traffic visualization: live ship positions, world ports, chokepoints, and aggregated shipping flows on an interactive map.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "build": "webpack",
    "watch": "webpack --watch",
    "start": "webpack serve --open",
    "prepare": "husky",
    "devStart": "nodemon server.js",
    "flows:aggregate": "node src/flowCli.js aggregate",
    "flows:stats": "node src/flowCli.js stats",
    "flows:cleanup": "node src/flowCli.js cleanup",
    "flows:clear": "node src/flowCli.js clear"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArgoAtlas/ArgoAtlas.git"
  },
  "author": "ArgoAtlas",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/ArgoAtlas/ArgoAtlas/issues"
  },
  "homepage": "https://github.com/ArgoAtlas/ArgoAtlas#readme",
  "dependencies": {
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/maplibre": "^9.4.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "h3-js": "^4.3.0",
    "maplibre-gl": "^6.9.0",
    "mongoose": "^9.10.0",
    "searoute-js": "^0.1.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "css-loader": "^7.1.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.0.11",
    "lint-staged": "^17.5.1",
    "nodemon": "^3.1.0",
    "prettier": "3.9.6",
    "webpack": "^5.101.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
